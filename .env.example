# Copy file này thành ".env" rồi điền giá trị thật vào.
# KHÔNG commit file ".env" lên git (đã có trong .gitignore).

# Adjust → Settings (góc dưới trái) → Account settings → tab "My profile" → API Token
ADJUST_API_TOKEN=dan_token_that_vao_day

# Danh sách App Token của TỪNG app muốn kéo, cách nhau bởi dấu phẩy, KHÔNG có khoảng trắng thừa.
# Lấy ở: Adjust → mở từng app → Cài đặt app → "App Token" (~12 ký tự)
# Ví dụ 3 app: ADJUST_APP_TOKENS=abc123def456,xyz789uvw012,qwe456rty789
ADJUST_APP_TOKENS=app_token_1,app_token_2

# GOOGLE_APPLICATION_CREDENTIALS: CẦN LẠI từ 23/09/2026 — trang "Benchmark"
# lưu dữ liệu qua Google Sheet (thay file JSON, hay bị mất khi app redeploy)
# — dùng CHUNG service account đã có sẵn từ thời BigQuery. Trỏ tới file
# service account key lưu ở thư mục dùng chung C:\Users\<ten_may_ban>\credentials\.
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\ten_ban\credentials\ten-file-service-account.json

# BENCHMARK_SHEET_ID: ID của Google Sheet dùng để lưu benchmark (lấy trong URL
# Sheet, đoạn giữa "/d/" và "/edit") — Sheet này phải được CHIA SẺ quyền Editor
# cho đúng email service account (xem trong file .json ở trên, trường
# "client_email") thì code mới đọc/ghi được.
BENCHMARK_SHEET_ID=dan_sheet_id_that_vao_day
